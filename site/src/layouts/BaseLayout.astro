---
import '../../../src/datum.css';
import '../styles/global.css';
import Header from '../components/Header.astro';

const {
    title = 'Datum',
    description = 'Composable data visualization for modern web applications.'
} = Astro.props;

const pageTitle =
    title === 'Datum'
        ? title
        : `${title} | Datum`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />

        <meta
            name="viewport"
            content="width=device-width"
        />

        <meta
            name="description"
            content={description}
        />

        <title>{pageTitle}</title>
    </head>

    <body>
        <Header />

        <main>
            <slot />
        </main>
    </body>
</html>